# The runner's settings. Copy this file to .env, fill it in, and keep it
# readable only by you: chmod 600 .env

# The token kagent sends and the runner checks. Create one with:
#   openssl rand -hex 32
REMOTE_HARNESS_TOKEN=

# Your coding agent's login.
# Claude Code: run `claude setup-token` and paste the token it prints. It uses
# your Claude subscription.
CLAUDE_CODE_OAUTH_TOKEN=
# Codex: an OpenAI API key.
# OPENAI_API_KEY=
